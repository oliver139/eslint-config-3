{
  "name": "@oliver139/eslint-config",
  "type": "module",
  "version": "8.0.0",
  "packageManager": "pnpm@12.16.1",
  "description": " Oliver's ESLint config preset powered by @antfu/eslint-config",
  "author": "Oliver Mak <oliver139.working@gmail.com> (https://github.com/oliver139)",
  "license": "MIT",
  "homepage": "https://oliver139.github.io/eslint-config-3/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliver139/eslint-config-3.git"
  },
  "bugs": {
    "url": "https://github.com/oliver139/eslint-config-3/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^26.13.0",
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "nlx @eslint/config-inspector --config eslint.config.ts",
    "build": "tsdown --clean --dts",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "prepack": "nr build",
    "release": "nlx bumpp && pnpm publish",
    "ncu": "nlx npm-check-updates"
  },
  "peerDependencies": {
    "@antfu/eslint-config": ">=9.5.1"
  },
  "peerDependenciesMeta": {
    "@antfu/eslint-config": {
      "optional": true
    }
  },
  "dependencies": {
    "eslint": "^10.13.0"
  },
  "optionalDependencies": {
    "eslint-plugin-better-tailwindcss": "^4.10.0"
  },
  "devDependencies": {
    "@antfu/ni": "latest",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.3",
    "typescript": "^6.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --cache --fix"
  }
}
